<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Manaure Vive · Revista Editorial de Destino y Catálogo Ecoturístico</title>
  <meta name="description" content="Brochure editorial de alta gama de Manaure Vive: 10 experiencias auténticas en la Serranía del Perijá, Cesar. Naturaleza, aventura, gastronomía y descanso a 34 km de Valledupar.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600;1,9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --g: #0F3D2A;                  /* Verde bosque esmeralda profundo (botánico) */
      --g2: #174D36;                 /* Verde musgo oscuro para hovers */
      --bg: #F7F1E5;                 /* Lienzo editorial cálido pergamino / lino */
      --paper: #FBF8F0;              /* Papel cálido para tarjetas y fichas */
      --sand: #E9E0CB;               /* Tono arena / piedra para secciones alternas */
      --sand-light: #F2EBDA;         /* Arena claro para pliegos alternos */
      --card: #FFFFFF;               /* Hojas blancas de revista nítidas */
      --card-hover: #F8F5EE;         /* Blanco pergamino al hover */
      --ink: #18251F;                /* Tinta carbón vegetal profundo (máxima legibilidad) */
      --mut: #52635A;                /* Tinta salvia oscura para textos descriptivos */
      --or: #E8830C;                 /* Naranja terracota / sol de montaña */
      --ot: #F3A03A;                 /* Ámbar para énfasis cursivos */
      --num: #0F3D2A;                /* Color institucional de números */
      --gold: #D4AE55;               /* Oro envejecido de montaña */
      --ln: rgba(24, 37, 31, .14);   /* Líneas finas editoriales de alta precisión */
      --sh: 0 20px 50px -25px rgba(15, 61, 42, .35); /* Sombra suave de papel */
      --radio-sm: 14px;
      --radio: 26px;
      --radio-lg: 32px;
      --radio-pill: 99px;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    * { box-sizing: border-box; margin: 0; }
    html {
      scroll-behavior: smooth;
      scroll-padding-top: calc(76px + env(safe-area-inset-top, 0px));
      height: 100%;
    }
    body {
      background: var(--bg);
      color: var(--ink);
      font: 400 15.5px/1.68 "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    h1, h2, h3, h4 {
      font-family: Fraunces, Georgia, serif;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -.02em;
    }
    em { font-style: italic; color: var(--or); }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; color: inherit; }

    /* ── CONTENEDOR PRINCIPAL EQUILIBRADO (1200px) ── */
    .w {
      max-width: 1200px;
      margin: auto;
      padding: 0 clamp(20px, 3.5vw, 36px);
    }
    section {
      padding: 80px 0;
      position: relative;
      background: var(--bg);
      color: var(--ink);
      transition: background-color .6s ease;
    }
    .alt { background: var(--sand); }
    section.alt::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 36px;
      background: linear-gradient(180deg, rgba(24, 37, 31, .05) 0%, transparent 100%);
      pointer-events: none;
    }
    section.alt::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 36px;
      background: linear-gradient(0deg, rgba(24, 37, 31, .05) 0%, transparent 100%);
      pointer-events: none;
    }

    /* ── ANIMACIONES DE TRANSICIÓN ENTRE SECCIONES ── */
    .reveal {
      opacity: 0;
      transform: translateY(34px);
      transition: opacity .85s cubic-bezier(.16, 1, .3, 1), transform .85s cubic-bezier(.16, 1, .3, 1);
      will-change: opacity, transform;
    }
    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── RESALTADOR EDITORIAL DE TEXTOS CLAVE (UNDERLINE y HIGHLIGHT) ── */
    .ed-hl {
      background: linear-gradient(120deg, rgba(232, 131, 12, .18) 0%, rgba(212, 174, 85, .28) 100%);
      border-bottom: 2px solid var(--or);
      padding: 1px 4px;
      border-radius: 4px;
      font-weight: 600;
      color: var(--ink);
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      transition: background .2s ease;
    }
    .ed-hl:hover {
      background: linear-gradient(120deg, rgba(232, 131, 12, .3) 0%, rgba(212, 174, 85, .45) 100%);
    }

    /* ── TIPOGRAFÍA Y ETIQUETAS EDITORIALES ── */
    .eb {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font: 700 12px/1 "Plus Jakarta Sans", sans-serif;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--or);
      background: rgba(232, 131, 12, .12);
      border: 1px solid rgba(232, 131, 12, .32);
      border-radius: var(--radio-pill);
      padding: 7px 16px;
      margin-bottom: 18px;
    }
    h1 {
      font-size: clamp(38px, 4.4vw, 56px);
      line-height: 1.1;
      margin-bottom: 0;
      letter-spacing: -.02em;
    }
    h2 {
      font-size: clamp(28px, 3.2vw, 42px);
      margin-bottom: 20px;
      line-height: 1.18;
      color: var(--g);
    }
    p {
      font-size: 15.5px;
      line-height: 1.68;
      color: var(--ink);
    }
    .lead {
      color: var(--mut);
      font-size: 17.5px;
      max-width: 65ch;
      line-height: 1.65;
    }

    /* ── BOTONES ── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 26px;
      border-radius: var(--radio-pill);
      font-weight: 700;
      font-size: 14.5px;
      border: 1.5px solid transparent;
      transition: all .25s ease;
      cursor: pointer;
      white-space: nowrap !important;
      text-decoration: none;
    }
    .b1 {
      background: var(--or);
      color: #fff;
      box-shadow: 0 8px 22px -6px rgba(232, 131, 12, .5);
    }
    .b1:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px -6px var(--or);
      background: #f5911e;
    }
    .b2 {
      border-color: rgba(255, 255, 255, .55);
      color: #fff;
      margin-left: 12px;
      background: rgba(255, 255, 255, .1);
    }
    .b2:hover {
      background: rgba(255, 255, 255, .22);
      transform: translateY(-2px);
    }
    .b-wa {
      background: var(--g);
      color: #fff;
      font-weight: 800;
      letter-spacing: .02em;
      box-shadow: 0 8px 22px -6px rgba(15, 61, 42, .4);
      padding: 14px 28px;
      font-size: 15px;
    }
    .b-wa:hover {
      background: var(--g2);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px -6px rgba(15, 61, 42, .55);
      color: #fff;
    }

    /* ── NAVEGACIÓN STICKY EDITORIAL (FROSTED LINEN) ── */
    nav {
      position: sticky;
      top: env(safe-area-inset-top, 0px);
      z-index: 50;
      background: rgba(247, 241, 229, .95);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--ln);
      box-shadow: 0 4px 16px rgba(24, 37, 31, .05);
    }
    nav .w {
      display: flex;
      align-items: center;
      gap: 24px;
      height: 72px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font: 600 21px Fraunces, Georgia, serif;
      color: var(--g);
      flex-shrink: 0;
    }
    .brand img {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: contain;
      background: #fff;
      border: 2px solid var(--gold);
      box-shadow: 0 3px 10px rgba(24, 37, 31, .12);
    }
    nav ul {
      display: flex;
      gap: 22px;
      list-style: none;
      margin-left: auto;
      padding: 0;
      font-size: 14.5px;
      font-weight: 600;
      color: var(--mut);
    }
    nav ul a {
      transition: color .2s ease;
      white-space: nowrap;
    }
    nav ul a:hover { color: var(--or); }
    @media (max-width: 1040px) {
      nav ul { display: none; }
    }

    /* ── 01. PORTADA EDITORIAL (HERO MAGAZINE COVER) ── */
    .hero {
      position: relative;
      color: #fff;
      padding: 0;
      background: var(--g) center/cover no-repeat url("../assets/convenios/serrania-perija-cordillera.webp");
    }
    .hero:before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(105deg, rgba(10, 36, 24, .95) 28%, rgba(10, 36, 24, .72) 100%);
    }
    .hero .w {
      position: relative;
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      gap: 48px;
      align-items: center;
      min-height: min(640px, 80vh);
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .hero .eb {
      color: #FFD479;
      background: rgba(255, 212, 121, .15);
      border-color: rgba(255, 212, 121, .35);
    }
    .hero .lead {
      color: #d6e3da;
      margin: 22px 0 32px;
      font-size: 17.5px;
      line-height: 1.65;
    }
    .lc {
      background: #FFFFFF;
      border-radius: 32px;
      padding: 32px;
      box-shadow: 0 24px 60px -16px rgba(0, 0, 0, .6);
      display: grid;
      place-items: center;
      border: 2px solid rgba(255, 255, 255, .7);
      animation: floatBadge 6s ease-in-out infinite;
      text-align: center;
      color: var(--ink);
    }
    @keyframes floatBadge {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    .lc img { width: 100%; max-width: 250px; height: auto; display: block; object-fit: contain; }
    .lc-caption {
      font-family: 'Fraunces', serif;
      font-size: 16.5px;
      font-weight: 600;
      color: var(--g);
      margin-top: 14px;
      letter-spacing: .02em;
    }
    .lc-sub {
      font-size: 12px;
      color: var(--mut);
      text-transform: uppercase;
      letter-spacing: .14em;
      margin-top: 4px;
      font-weight: 700;
    }
    @media (max-width: 960px) {
      .hero .w { grid-template-columns: 1fr; gap: 36px; padding-top: 48px; padding-bottom: 48px; min-height: auto; }
      .lc { max-width: 280px; margin: auto; padding: 24px; }
      .b2 { margin-left: 0; margin-top: 10px; }
    }

    /* ── ÍNDICE RÁPIDO EDITORIAL ── */
    .idx {
      background: var(--g);
      color: #fff;
      border-bottom: 2px solid rgba(255, 255, 255, .12);
      box-shadow: 0 10px 36px rgba(15, 61, 42, .35);
    }
    .idx ol {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
    }
    .idx li {
      border-left: 1px solid rgba(255, 255, 255, .14);
    }
    .idx li:first-child { border-left: 1px solid rgba(255, 255, 255, .14); }
    .idx li:last-child { border-right: 1px solid rgba(255, 255, 255, .14); }
    .idx a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 32px 18px;
      gap: 8px;
      text-decoration: none;
      transition: all .25s ease;
    }
    .idx a:hover { background: rgba(255, 255, 255, .12); }
    .idx a:hover .idx-n { transform: translateY(-3px); }
    .idx-n {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 26px;
      font-weight: 800;
      color: #FFC61A;
      letter-spacing: .06em;
      line-height: 1;
      transition: transform .2s ease;
    }
    .idx-t {
      font-size: 17px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: .01em;
      line-height: 1.3;
    }
    @media (max-width: 960px) {
      .idx ol { grid-template-columns: repeat(3, 1fr); }
      .idx li { border-bottom: 1px solid rgba(255, 255, 255, .14); }
    }
    @media (max-width: 580px) {
      .idx ol { grid-template-columns: repeat(2, 1fr); }
      .idx a { padding: 22px 10px; }
      .idx-n { font-size: 22px; }
      .idx-t { font-size: 15px; }
    }

    /* ── SECCIÓN 01: EL PROYECTO ── */
    .two {
      display: grid;
      grid-template-columns: 1.18fr .82fr;
      gap: 68px;
      align-items: start;
    }
    @media (max-width: 960px) { .two { grid-template-columns: 1fr; gap: 48px; } }
    .two p + p { margin-top: 20px; color: var(--mut); }
    .vals { margin-top: 36px; display: grid; gap: 20px; }
    .vals div {
      padding-left: 24px;
      border-left: 4.5px solid var(--or);
      font-size: 17px;
      color: var(--mut);
      line-height: 1.65;
    }
    .vals b { display: block; color: var(--g); font-size: 19px; margin-bottom: 6px; }

    /* Estadísticas destacadas */
    .st {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5px;
      background: var(--ln);
      border: 1px solid var(--ln);
      border-radius: 30px;
      overflow: hidden;
      box-shadow: var(--sh);
    }
    .st div {
      background: #FFFFFF;
      padding: 44px 36px;
      color: var(--mut);
      font-size: 17.5px;
      font-weight: 600;
      line-height: 1.5;
      transition: background .2s ease;
    }
    .st div:hover { background: var(--paper); }
    .st b {
      display: block;
      font: 600 clamp(50px, 4.5vw, 64px)/1.05 Fraunces, Georgia, serif;
      color: var(--g);
      margin-bottom: 12px;
    }

    /* ── SECCIÓN 02: EL DESTINO y ESCALA ALTITUDINAL ── */
    .mos {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      grid-template-rows: 270px 270px;
      gap: 20px;
      margin-top: 44px;
    }
    .mos img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 26px;
      border: 1px solid var(--ln);
      box-shadow: var(--sh);
      transition: transform .4s ease;
    }
    .mos img:hover { transform: scale(1.02); }
    .mos img:first-child { grid-row: span 2; }
    @media (max-width: 960px) { .mos { grid-template-rows: 210px 210px; } }
    @media (max-width: 640px) {
      .mos { grid-template-columns: 1fr; grid-template-rows: 240px 180px 180px; }
      .mos img:first-child { grid-row: auto; }
    }

    .facts {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      margin-top: 32px;
    }
    @media (max-width: 1024px) { .facts { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .facts { grid-template-columns: 1fr; } }
    .fc {
      background: #FFFFFF;
      border: 1px solid var(--ln);
      border-radius: 26px;
      padding: 34px 30px;
      font-size: 17px;
      color: var(--mut);
      line-height: 1.7;
      box-shadow: 0 10px 30px -15px rgba(24, 37, 31, .15);
    }
    .fc h3 {
      font: 700 14.5px "Plus Jakarta Sans", sans-serif;
      letter-spacing: .15em;
      text-transform: uppercase;
      color: var(--or);
      margin-bottom: 12px;
    }

    /* ── TABLA COMPARATIVA y GRADIENTE ALTITUDINAL EDITORIAL ── */
    .alt-widget {
      margin-top: 28px;
      background: #FFFFFF;
      border: 1px solid var(--ln);
      border-radius: 20px;
      padding: 22px 24px;
      box-shadow: 0 6px 24px -10px rgba(24, 37, 31, .08);
      max-width: 840px;
      margin-left: auto;
      margin-right: auto;
      box-sizing: border-box;
      overflow: hidden;
    }
    .alt-head {
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      flex-wrap: wrap;
    }
    .alt-head h3 { font-size: 18px; color: var(--g); margin: 0 0 4px 0; }
    .alt-head p { font-size: 12.5px; color: var(--mut); line-height: 1.45; margin: 0; max-width: 62ch; }
    
    .alt-table-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .alt-editorial-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 12px;
    }
    .alt-editorial-table thead th {
      padding: 8px 10px;
      background: rgba(15, 61, 42, .04);
      color: var(--g);
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      border-bottom: 2px solid rgba(15, 61, 42, .15);
      white-space: nowrap;
    }
    .th-aliado { width: 33%; }
    .th-piso { width: 22%; }
    .th-alt { width: 14%; text-align: right; }
    .th-temp { width: 11%; text-align: center; }
    .th-cota { width: 20%; }

    .alt-editorial-table tbody tr {
      border-bottom: 1px solid rgba(24, 37, 31, .06);
      transition: background .2s ease;
    }
    .alt-editorial-table tbody tr:last-child {
      border-bottom: none;
    }
    .alt-editorial-table tbody tr:hover {
      background: rgba(232, 131, 12, .04);
    }
    .alt-editorial-table td {
      padding: 6px 10px;
      vertical-align: middle;
      color: var(--ink);
    }
    .td-aliado {
      font-size: 12px;
      color: var(--g);
      white-space: nowrap;
    }
    .td-aliado b { color: var(--g); font-weight: 700; }
    .alt-sub { font-size: 11px; color: var(--mut); font-weight: normal; }
    .alt-emoji { font-size: 13px; margin-right: 4px; display: inline-block; vertical-align: middle; }
    .td-piso {
      font-size: 11px;
      color: var(--mut);
      white-space: nowrap;
    }
    .piso-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      margin-right: 5px;
      vertical-align: middle;
    }
    .dot-c { background: #FFC61A; box-shadow: 0 0 6px rgba(255, 198, 26, .6); }
    .dot-t { background: #2E9E4F; box-shadow: 0 0 6px rgba(46, 158, 79, .6); }
    .dot-f { background: #2BA6D9; box-shadow: 0 0 6px rgba(43, 166, 217, .6); }
    .dot-p { background: #A765FF; box-shadow: 0 0 6px rgba(167, 101, 255, .6); }
    .td-alt {
      font-size: 11.5px;
      color: var(--g);
      font-weight: 600;
      text-align: right;
      white-space: nowrap;
    }
    .td-temp {
      text-align: center;
      white-space: nowrap;
    }
    .temp-badge {
      display: inline-block;
      font-size: 10px;
      font-weight: 700;
      color: var(--g);
      background: rgba(15, 61, 42, .06);
      border: 1px solid rgba(15, 61, 42, .16);
      border-radius: var(--radio-pill);
      padding: 1px 7px;
    }
    .td-cota {
      vertical-align: middle;
    }
    .alt-track {
      width: 100%;
      height: 5px;
      background: rgba(24, 37, 31, .08);
      border-radius: var(--radio-pill);
      overflow: hidden;
      position: relative;
    }
    .alt-bar {
      height: 100%;
      border-radius: var(--radio-pill);
      transition: width 1.2s cubic-bezier(.16, 1, .3, 1);
    }
    tr[data-piso="c"] .alt-bar { background: linear-gradient(90deg, #FFC61A, #FF8A00); }
    tr[data-piso="t"] .alt-bar { background: linear-gradient(90deg, #FF8A00, #2E9E4F); }
    tr[data-piso="f"] .alt-bar { background: linear-gradient(90deg, #2E9E4F, #2BA6D9); }
    tr[data-piso="p"] .alt-bar { background: linear-gradient(90deg, #2BA6D9, #A765FF); }

    /* MÓVIL: La tabla se transforma en micro-tarjetas apiladas elegantes sin provocar scroll horizontal */
    @media (max-width: 640px) {
      .alt-widget {
        padding: 16px 14px;
        border-radius: 16px;
        margin-top: 18px;
      }
      .alt-table-wrap {
        overflow-x: visible;
      }
      .alt-editorial-table,
      .alt-editorial-table tbody,
      .alt-editorial-table tr,
      .alt-editorial-table td {
        display: block;
        width: 100%;
        box-sizing: border-box;
      }
      .alt-editorial-table thead {
        display: none;
      }
      .alt-editorial-table tbody tr {
        background: rgba(15, 61, 42, .025);
        border: 1px solid var(--ln);
        border-radius: 10px;
        padding: 7px 10px;
        margin-bottom: 6px;
      }
      .alt-editorial-table td {
        padding: 2px 0;
      }
      .alt-editorial-table td.td-aliado {
        font-size: 11.5px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .alt-editorial-table td.td-piso {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 10px;
        margin-top: 1px;
      }
      .alt-editorial-table td.td-alt,
      .alt-editorial-table td.td-temp {
        display: none;
      }
      .alt-mobile-meta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .alt-mobile-alt {
        font-size: 10.5px;
        font-weight: 700;
        color: var(--g);
      }
      .alt-editorial-table td.td-cota {
        margin-top: 4px;
      }
      .alt-track {
        height: 4px;
      }
    }

    /* ── SECCIÓN 03: LOS 4 PILARES DEL PERIJÁ ── */
    .pil {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
      margin-top: 48px;
    }
    @media (max-width: 1100px) { .pil { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .pil { grid-template-columns: 1fr; } }
    .pc {
      background: #FFFFFF;
      border: 1px solid var(--ln);
      border-radius: 28px;
      padding: 38px 32px;
      display: flex;
      flex-direction: column;
      box-shadow: var(--sh);
      transition: transform .3s ease, background .3s ease;
    }
    .pc:hover { transform: translateY(-6px); background: var(--paper); }
    .pc i {
      font: 700 16px "Plus Jakarta Sans", sans-serif;
      color: var(--or);
      font-style: normal;
      letter-spacing: .08em;
    }
    .pc h3 { font-size: 30px; margin: 10px 0 14px; color: var(--g); }
    .pc p { color: var(--mut); font-size: 17px; margin-bottom: 26px; flex: 1; line-height: 1.68; }
    .chip {
      display: inline-block;
      margin: 0 8px 10px 0;
      padding: 9px 18px;
      border-radius: var(--radio-pill);
      border: 1px solid var(--ln);
      background: rgba(15, 61, 42, .06);
      font-size: 15px;
      font-weight: 700;
      color: var(--g);
      transition: .2s ease;
    }
    button.chip:hover {
      border-color: var(--or);
      color: #fff;
      background: var(--or);
      transform: translateY(-2px);
    }

    /* ── SECCIÓN 04: LOS 10 CONVENIOS (VIEWPORT OPTIMIZED y REVISTA EDITORIAL) ── */
    #convenios {
      padding: 48px 0 40px !important;
      position: relative;
    }
    .ed-intro-box {
      text-align: center;
      max-width: 66ch;
      margin: 0 auto 22px;
    }
    .ed-intro-box .eb {
      margin-bottom: 8px;
      font-size: 11px;
      padding: 5px 14px;
    }
    .ed-intro-box h2 {
      font-size: clamp(24px, 2.6vw, 34px);
      margin-bottom: 8px;
      line-height: 1.15;
    }
    .ed-intro-box .lead {
      font-size: 14.5px;
      line-height: 1.5;
      margin: 0 auto;
      max-width: 60ch;
    }

    /* Cuadrícula de 10 convenios: 5×2 en Desktop, sin scroll horizontal, cabe en el viewport */
    .ed-toc-container {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 38px;
      width: 100%;
      box-sizing: border-box;
      overflow: visible;
    }

    /* Tablet / Laptop compacta */
    @media (max-width: 1080px) and (min-width: 769px) {
      .ed-toc-container {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 8px;
      }
    }
    @media (max-width: 768px) and (min-width: 581px) {
      .ed-toc-container {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
      }
    }
    /* Teléfono: Exactamente 2 columnas (01 02 / 03 04 / 05 06 / 07 08 / 09 10) */
    @media (max-width: 580px) {
      .ed-toc-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 8px !important;
        margin-bottom: 28px !important;
      }
    }
    @media (max-width: 340px) {
      .ed-toc-container {
        grid-template-columns: 1fr !important;
        gap: 6px !important;
      }
    }

    .ed-toc-item {
      background: #FFFFFF;
      border: 1px solid var(--ln);
      border-radius: 12px;
      padding: 8px 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      width: 100%;
      box-sizing: border-box;
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
      color: var(--ink);
      text-align: left;
      box-shadow: 0 2px 8px -2px rgba(24, 37, 31, .06);
      overflow: hidden;
      text-decoration: none;
    }
    .ed-toc-item:hover {
      background: var(--paper);
      border-color: var(--or);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px -4px rgba(232, 131, 12, .22);
    }
    .ed-toc-num {
      font-family: 'Fraunces', serif;
      font-size: 14px;
      font-weight: 700;
      color: var(--or);
      flex-shrink: 0;
      line-height: 1;
      letter-spacing: -.02em;
    }
    .ed-toc-logo {
      width: 28px !important;
      height: 28px !important;
      border-radius: 50% !important;
      background: #fff;
      object-fit: contain;
      padding: 2px;
      border: 1.5px solid var(--gold);
      box-shadow: 0 1px 4px rgba(24, 37, 31, .08);
      flex-shrink: 0;
    }
    .ed-toc-text {
      min-width: 0;
      flex: 1;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    .ed-toc-name {
      display: block;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--g);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.25;
    }
    .ed-toc-cat {
      font-size: 9.5px;
      font-weight: 500;
      color: var(--mut);
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.2;
    }
    @media (max-width: 580px) {
      .ed-toc-item {
        padding: 7px 8px;
        gap: 6px;
        border-radius: 10px;
      }
      .ed-toc-num {
        font-size: 13px;
      }
      .ed-toc-logo {
        width: 26px !important;
        height: 26px !important;
      }
      .ed-toc-name {
        font-size: 11px;
      }
      .ed-toc-cat {
        font-size: 9px;
      }
    }

    /* ── PLIEGOS EDITORIALES DE LOS 10 ALIADOS ── */
    .ed-spread {
      padding: 110px 0;
      border-top: 1px solid rgba(24, 37, 31, .12);
      position: relative;
      background: var(--bg);
    }
    .ed-spread:nth-of-type(even) {
      background: var(--sand-light);
    }

    /* Cabecera común de cada pliego */
    .ed-header { margin-bottom: 24px; }
    .ed-folio {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }
    .ed-num {
      font-family: 'Fraunces', serif;
      font-size: clamp(38px, 4vw, 54px);
      font-weight: 700;
      color: var(--g);
      line-height: 1;
    }
    .ed-line {
      height: 2px;
      width: 50px;
      background: var(--or);
      opacity: .8;
    }
    .ed-tag {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--mut);
    }
    .ed-brand-row {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .ed-logo-circle {
      width: 84px !important;
      height: 84px !important;
      border-radius: 50% !important;
      background: #fff;
      object-fit: contain;
      padding: 6px;
      border: 3px solid var(--gold);
      box-shadow: 0 8px 24px rgba(24, 37, 31, .2);
      flex: none;
    }
    .ed-name {
      font-size: clamp(32px, 3.5vw, 46px);
      color: var(--g);
      line-height: 1.15;
    }
    .ed-headline {
      font-size: clamp(24px, 2.4vw, 34px);
      color: var(--ink);
      font-weight: 600;
      line-height: 1.25;
      margin: 18px 0 14px;
    }
    .ed-quote {
      font-family: 'Fraunces', serif;
      font-style: italic;
      font-size: 20.5px;
      color: var(--g);
      line-height: 1.6;
      border-left: 4.5px solid var(--or);
      padding-left: 20px;
      margin: 20px 0 24px;
    }
    .ed-quote-gold { color: var(--g); border-left-color: var(--gold); }
    .ed-story {
      font-size: 18.5px;
      line-height: 1.75;
      color: var(--ink);
      margin-bottom: 30px;
    }

    /* Marcos fotográficos editoriales */
    .ed-photo-frame {
      position: relative;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: 0 20px 50px -15px rgba(24, 37, 31, .35);
      border: 1px solid var(--ln);
    }
    .ed-img-cover {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .5s ease;
    }
    .ed-photo-frame:hover .ed-img-cover { transform: scale(1.03); }
    .ed-photo-tag {
      position: absolute;
      bottom: 16px;
      left: 18px;
      background: rgba(15, 61, 42, .88);
      backdrop-filter: blur(8px);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .08em;
      padding: 6px 16px;
      border-radius: var(--radio-pill);
      border: 1px solid rgba(255, 255, 255, .25);
    }

    /* Ficha de Campo Técnica */
    .ed-field-notes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin: 28px 0;
    }
    @media (max-width: 580px) { .ed-field-notes { grid-template-columns: 1fr; } }
    .ed-fn-item {
      background: #FFFFFF;
      border: 1px solid var(--ln);
      border-radius: 18px;
      padding: 16px 20px;
      box-shadow: 0 4px 14px rgba(24, 37, 31, .06);
    }
    .ed-fn-label {
      display: block;
      font-size: 12.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .12em;
      color: var(--or);
      margin-bottom: 4px;
    }
    .ed-fn-val {
      font-size: 16.5px;
      font-weight: 700;
      color: var(--g);
    }
    .ed-tip-box {
      border-left: 4.5px solid var(--or);
      background: rgba(232, 131, 12, .1);
      padding: 20px 24px;
      border-radius: 0 18px 18px 0;
      font-size: 16.5px;
      line-height: 1.65;
      margin: 22px 0;
      color: var(--ink);
    }
    .ed-tip-box b { display: block; color: var(--g); margin-bottom: 4px; }
    .ed-chips-box { margin: 24px 0 28px; }
    .ed-chips-title {
      display: block;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--mut);
      margin-bottom: 12px;
    }
    .ed-chips-list .chip {
      background: #FFFFFF;
      border: 1px solid var(--ln);
      color: var(--g);
      font-weight: 700;
      box-shadow: 0 2px 8px rgba(24, 37, 31, .05);
    }

    /* Barra de Redes Sociales de cada aliado */
    .ed-social-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin: 28px 0 22px;
      padding-top: 24px;
      border-top: 1px solid var(--ln);
    }
    .ed-soc-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: var(--radio-pill);
      font-size: 15px;
      font-weight: 700;
      border: 1px solid var(--ln);
      background: #FFFFFF;
      color: var(--g);
      transition: all .25s ease;
      box-shadow: 0 2px 8px rgba(24, 37, 31, .06);
    }
    .ed-soc-link:hover {
      transform: translateY(-2px);
      border-color: var(--or);
      color: var(--or);
      background: var(--paper);
    }
    .ed-soc-ig {
      background: rgba(221, 42, 123, .08);
      border-color: rgba(221, 42, 123, .3);
      color: #C13584;
    }
    .ed-soc-ig:hover {
      background: linear-gradient(45deg, #F58529, #DD2A7B);
      color: #fff;
      border-color: transparent;
    }
    .ed-soc-wa {
      background: rgba(37, 211, 102, .12);
      border-color: rgba(37, 211, 102, .35);
      color: #128C7E;
    }
    .ed-soc-wa:hover {
      background: #25D366;
      color: #fff;
      border-color: transparent;
    }

    /* Caja de Reserva por WhatsApp */
    .ed-cta-box {
      margin-top: 28px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .ed-cta-note {
      font-size: 14px;
      color: var(--mut);
      font-style: italic;
    }

    /* ── VARIANTES DE LAYOUT EDITORIAL ── */
    /* Layout A */
    .ed-grid-a {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 60px;
      align-items: start;
    }
    .ed-layout-a .main-frame { height: 520px; margin-bottom: 24px; }
    .ed-layout-a .sub-frame { height: 260px; }

    /* Layout B */
    .ed-grid-b {
      display: grid;
      grid-template-columns: .95fr 1.05fr;
      gap: 60px;
      align-items: start;
    }
    /* Layout C */
    .ed-grid-c {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 60px;
      align-items: start;
    }
    .ed-col-photo-dual { display: grid; gap: 24px; }
    .dual-1 { height: 460px; }
    .dual-2 { height: 320px; }

    /* Layout C: Panorama Inmersivo */
    .ed-panorama-box {
      position: relative;
      width: 100%;
      min-height: 820px;
      overflow: hidden;
      display: flex;
      align-items: center;
    }
    .ed-panorama-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .ed-panorama-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(15, 61, 42, .92) 20%, rgba(15, 61, 42, .6) 60%, rgba(15, 61, 42, .85) 100%);
    }
    .ed-panorama-content {
      position: relative;
      z-index: 5;
      padding: 60px 0;
    }
    .ed-glass-card {
      background: rgba(255, 255, 255, .95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--ln);
      border-radius: 36px;
      padding: 52px;
      max-width: 860px;
      box-shadow: 0 30px 80px rgba(15, 61, 42, .3);
      color: var(--ink);
    }
    .ed-glass-card .ed-num { color: var(--g); }
    .ed-glass-card .ed-name { color: var(--g); }
    .ed-glass-card .ed-headline { color: var(--ink); }
    .ed-glass-card .ed-quote { color: var(--g); }
    .ed-glass-card .ed-story { color: var(--ink); }
    .ed-secondary-photo-strip {
      height: 220px;
      border-radius: 20px;
      overflow: hidden;
      margin: 24px 0;
      border: 1px solid var(--ln);
    }
    .ed-strip-img { width: 100%; height: 100%; object-fit: cover; }

    /* Layout D: Portada Nocturna / Cabaña */
    .ed-grid-d {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: start;
    }
    .vertical-frame { height: 600px; margin-bottom: 24px; }
    .sub-small-frame { height: 240px; }
    .ed-night-badge {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(15, 61, 42, .88);
      backdrop-filter: blur(10px);
      color: var(--gold);
      font-size: 14px;
      font-weight: 700;
      padding: 8px 18px;
      border-radius: var(--radio-pill);
      border: 1px solid var(--gold);
    }

    /* Layout E: Reportaje Científico / Gastronómico */
    .ed-grid-e {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: start;
    }
    .science-main { height: 480px; margin-bottom: 24px; }
    .science-sub { height: 280px; }

    @media (max-width: 980px) {
      .ed-grid-a, .ed-grid-b, .ed-grid-c, .ed-grid-d, .ed-grid-e {
        grid-template-columns: 1fr;
        gap: 40px;
      }
      .ed-layout-a .main-frame, .dual-1, .vertical-frame, .science-main { height: 400px; }
      .ed-glass-card { padding: 36px 26px; }
    }

    /* ── SECCIÓN 05: CUADERNO DE RUTAS CURADAS ── */
    .rt-container {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-top: 24px;
    }
    @media (max-width: 1100px) { .rt-container { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .rt-container { grid-template-columns: 1fr; } }
    .rc {
      background: #FFFFFF;
      color: var(--ink);
      border: 1px solid var(--ln);
      border-radius: 16px;
      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      box-shadow: var(--sh);
      transition: transform .3s ease;
    }
    .rc:hover { transform: translateY(-4px); }
    .rc small {
      color: var(--or);
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      font-size: 11px;
    }
    .rc h3 { font-size: 18px; margin: 4px 0 0; color: var(--g); }
    .rc ol {
      list-style: none;
      padding: 0;
      margin-top: 12px;
      counter-reset: s;
      display: flex;
      flex-direction: column;
    }
    .rc li {
      counter-increment: s;
      display: flex;
      gap: 10px;
      padding: 8px 0;
      border-top: 1px solid var(--ln);
      font-size: 12.5px;
      color: var(--mut);
      line-height: 1.4;
    }
    .rc li:before {
      content: counter(s);
      flex: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--or);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      display: grid;
      place-items: center;
    }
    .rc li b { display: block; color: var(--g); font-size: 13px; margin-bottom: 2px; }

    /* ── SECCIÓN 06: GUÍA PRÁCTICA DEL VIAJERO y QR ── */
    .guia-grid {
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      gap: 36px;
      margin-top: 44px;
      align-items: start;
    }
    @media (max-width: 980px) { .guia-grid { grid-template-columns: 1fr; } }
    .guia-facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    @media (max-width: 640px) { .guia-facts { grid-template-columns: 1fr; } }
    .qr-card {
      background: #FFFFFF;
      border: 2px solid var(--gold);
      border-radius: 32px;
      padding: 44px 38px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: var(--sh);
      color: var(--ink);
    }
    .qr-box {
      background: var(--paper);
      padding: 18px;
      border-radius: 24px;
      box-shadow: 0 10px 30px rgba(24, 37, 31, .12);
      border: 1px solid var(--ln);
      margin: 22px 0;
      display: inline-block;
    }
    .qr-img {
      width: 170px;
      height: 170px;
      display: block;
    }
    .qr-card h3 { font-size: 28px; color: var(--g); }
    .qr-card p { font-size: 16.5px; color: var(--mut); line-height: 1.65; margin-bottom: 22px; }
    .btn-pdf-sub {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      margin-top: 10px;
      padding: 9px 18px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--g);
      background: #F3F7F4;
      border: 1.5px solid rgba(24, 37, 31, .16);
      border-radius: 999px;
      cursor: pointer;
      width: 100%;
      box-sizing: border-box;
      transition: all .2s ease;
      font-family: inherit;
    }
    .btn-pdf-sub:hover {
      background: var(--g);
      color: #FFFFFF;
      border-color: var(--g);
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(24, 37, 31, .18);
    }
    .btn-pdf-sub svg {
      transition: transform .2s ease;
    }
    .btn-pdf-sub:hover svg {
      transform: translateY(1px);
    }

    /* ── SECCIÓN 07: FOOTER y MARQUEE INFINITO DE LOGOS ── */
    footer {
      background: var(--g);
      color: #fff;
      padding: 100px 0 60px;
      text-align: center;
      overflow: hidden;
      border-top: 1px solid var(--ln);
    }
    footer h2 { font-size: clamp(34px, 5vw, 54px); margin-bottom: 20px; color: #fff; }
    /* Vitrina Editorial de los 10 Aliados (Estática, Grande y 100% Visible) */
    .fl-showcase {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 14px;
      max-width: 1040px;
      margin: 32px auto 36px;
      padding: 0 10px;
      box-sizing: border-box;
    }
    .fl-item {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      padding: 0;
      background: none;
      text-decoration: none;
      cursor: pointer;
      flex: none;
      transition: transform .25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .fl-item:hover {
      transform: translateY(-5px) scale(1.1);
    }
    .fl-img {
      width: 74px !important;
      height: 74px !important;
      border-radius: 50% !important;
      object-fit: contain;
      background: #FFFFFF;
      padding: 7px;
      border: 2.5px solid var(--gold);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .38), 0 0 0 1px rgba(255, 212, 121, .3);
      display: block;
      box-sizing: border-box;
      transition: border-color .25s ease, box-shadow .25s ease;
    }
    .fl-item:hover .fl-img {
      border-color: #FFFFFF;
      box-shadow: 0 12px 28px rgba(0, 0, 0, .5), 0 0 16px rgba(255, 212, 121, .65);
    }
    @media (max-width: 980px) and (min-width: 681px) {
      .fl-showcase {
        gap: 12px 10px;
        max-width: 700px;
      }
      .fl-img {
        width: 64px !important;
        height: 64px !important;
        padding: 6px;
      }
    }
    @media (max-width: 680px) {
      .fl-showcase {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px 8px;
        max-width: 360px;
        margin: 24px auto 28px;
      }
      .fl-img {
        width: 54px !important;
        height: 54px !important;
        padding: 5px;
        border-width: 2px;
        margin: 0 auto;
      }
    }
    @media (max-width: 360px) {
      .fl-showcase {
        gap: 8px 6px;
        max-width: 310px;
      }
      .fl-img {
        width: 48px !important;
        height: 48px !important;
        padding: 4px;
      }
    }
    .fl-desc {
      font-size: 18px;
      line-height: 1.72;
      color: #FFFFFF !important;
      max-width: 66ch;
      margin: 0 auto 28px;
      font-weight: 400;
      letter-spacing: .01em;
      text-shadow: 0 1px 3px rgba(0, 0, 0, .4);
    }
    .fl-credits {
      margin-top: 38px;
      padding-top: 26px;
      border-top: 1px solid rgba(255, 212, 121, .3);
    }
    .fl-location {
      font-size: 16.5px;
      font-weight: 700;
      color: #FFFFFF !important;
      letter-spacing: .05em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 6px;
      text-shadow: 0 1px 3px rgba(0, 0, 0, .4);
    }
    .fl-sep {
      color: var(--gold);
      font-weight: 900;
      padding: 0 4px;
    }
    .fl-sub {
      font-size: 14px;
      color: #D2E4DA !important;
      font-weight: 500;
      margin-top: 6px;
      letter-spacing: .02em;
    }
    @media (max-width: 600px) {
      .fl-desc {
        font-size: 16px;
        line-height: 1.6;
        padding: 0 14px;
      }
      .fl-location {
        font-size: 14px;
        letter-spacing: .03em;
        line-height: 1.45;
      }
      .fl-sub {
        font-size: 12.5px;
      }
    }
    .nav-cta-btn {
      padding: 12px 24px;
      font-size: 15px;
      letter-spacing: .01em;
      box-shadow: 0 8px 20px -6px rgba(232, 131, 12, .45);
      white-space: nowrap;
    }

    /* ── AJUSTES COMPLETOS PARA MÓVILES (CELULARES) ── */
    @media (max-width: 768px) {
      body {
        font-size: 16.5px;
        line-height: 1.7;
      }
      .w {
        padding: 0 20px;
        width: 100%;
      }
      nav .w {
        height: 72px;
        gap: 12px;
      }
      .brand {
        font-size: 20px;
        gap: 10px;
      }
      .brand img {
        width: 44px;
        height: 44px;
      }
      .nav-cta-btn {
        padding: 9px 16px;
        font-size: 13.5px;
        margin-left: auto;
      }
      nav ul {
        display: none;
      }
      section {
        padding: 72px 0;
      }
      .hero {
        min-height: auto;
        padding: 55px 0 50px;
      }
      .hero .w {
        grid-template-columns: 1fr;
        gap: 32px;
        min-height: auto;
      }
      .hero h1 {
        font-size: clamp(36px, 9.5vw, 50px);
        line-height: 1.12;
        margin: 16px 0;
      }
      .hero .lead {
        font-size: 17px;
        line-height: 1.6;
        margin-bottom: 24px;
      }
      .hero .btn {
        width: 100%;
        margin-bottom: 10px;
      }
      .hero .b2 {
        margin-left: 0;
      }
      .lc {
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
        padding: 24px;
      }
      .lc img {
        width: 100px;
        height: 100px;
      }
      .editor-index ol {
        grid-template-columns: repeat(2, 1fr);
      }
      .editor-index a {
        padding: 16px 12px;
        font-size: 13.5px;
        border-bottom: 1px solid rgba(255, 255, 255, .15);
      }
      .editor-index b {
        font-size: 24px;
      }
      .st {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      .st div {
        padding: 20px 14px;
      }
      .st b {
        font-size: 34px;
      }
      .st span {
        font-size: 14px;
      }
      .facts {
        grid-template-columns: 1fr;
        gap: 16px;
      }
      .fact {
        padding: 22px 18px;
      }
      .pil {
        grid-template-columns: 1fr;
        gap: 18px;
      }
      .pc {
        padding: 24px 20px;
      }

      /* Índice de convenios en móvil: 2 columnas compactas */
      .ed-toc-container {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 8px !important;
        margin-bottom: 24px !important;
      }
      .ed-toc-item {
        padding: 7px 8px !important;
        gap: 6px !important;
        border-radius: 10px !important;
      }
      .ed-toc-num {
        font-size: 12.5px !important;
      }
      .ed-toc-logo {
        width: 26px !important;
        height: 26px !important;
      }
      .ed-toc-name {
        font-size: 11px !important;
      }
      .ed-toc-cat {
        font-size: 9px !important;
      }

      /* Pliegos editoriales en móvil */
      .ed-spread {
        padding: 60px 0;
      }
      .ed-grid-a, .ed-grid-b, .ed-grid-c, .ed-grid-d, .ed-grid-e {
        grid-template-columns: 1fr;
        gap: 28px;
      }
      .ed-col-photo, .ed-col-photo-dual, .ed-col-photo-vertical, .ed-col-photo-science {
        order: 1;
      }
      .ed-col-story {
        order: 2;
      }
      .ed-layout-a .main-frame, .dual-1, .vertical-frame, .science-main {
        height: 290px !important;
        border-radius: 20px;
        margin-bottom: 12px;
      }
      .sub-frame, .dual-2, .sub-small-frame, .science-sub {
        height: 180px !important;
        border-radius: 16px;
      }
      .ed-brand-row {
        gap: 14px;
      }
      .ed-logo-circle {
        width: 64px !important;
        height: 64px !important;
        padding: 4px;
      }
      .ed-name {
        font-size: clamp(26px, 6.5vw, 34px) !important;
      }
      .ed-headline {
        font-size: 20px !important;
        line-height: 1.3;
        margin: 14px 0 10px;
      }
      .ed-quote {
        font-size: 17.5px !important;
        line-height: 1.55;
        padding-left: 14px;
        margin: 14px 0 18px;
        border-left-width: 3.5px;
      }
      .ed-story {
        font-size: 16.5px !important;
        line-height: 1.72;
        margin-bottom: 22px;
      }
      .ed-field-notes {
        grid-template-columns: 1fr;
        gap: 10px;
        margin: 20px 0;
      }
      .ed-fn-item {
        padding: 14px 16px;
        border-radius: 14px;
      }
      .ed-fn-label {
        font-size: 11.5px;
      }
      .ed-fn-val {
        font-size: 15.5px;
      }
      .ed-tip-box {
        padding: 16px 18px;
        font-size: 15.5px;
        border-radius: 0 14px 14px 0;
        margin: 18px 0;
      }
      .ed-chips-box {
        margin: 18px 0 22px;
      }
      .chip {
        font-size: 13.5px;
        padding: 8px 14px;
        margin: 0 6px 8px 0;
      }
      .ed-social-bar {
        gap: 10px;
        margin: 20px 0 16px;
        padding-top: 18px;
      }
      .ed-soc-link {
        padding: 9px 16px;
        font-size: 14px;
      }
      .ed-cta-box {
        margin-top: 20px;
        width: 100%;
      }
      .btn.b-wa {
        width: 100%;
        justify-content: center;
        padding: 16px 20px;
        font-size: 16px;
      }
      .ed-cta-note {
        text-align: center;
        width: 100%;
        font-size: 13px;
      }

      /* Panorama Box (Convenios 03 y 08) */
      .ed-panorama-box {
        min-height: auto;
        padding: 36px 14px;
      }
      .ed-glass-card {
        padding: 26px 18px !important;
        border-radius: 24px !important;
      }
      .ed-secondary-photo-strip {
        height: 180px;
      }

      /* Rutas y Guía */
      .rt-container {
        grid-template-columns: 1fr;
        gap: 18px;
      }
      .rc {
        padding: 28px 22px;
      }
      .guia-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      .guia-facts {
        grid-template-columns: 1fr;
      }
      .qr-card {
        padding: 32px 20px;
      }
      footer {
        padding: 70px 0 45px;
      }
    }

    @media (max-width: 480px) {
      .editor-index ol {
        grid-template-columns: 1fr;
      }
      .st {
        grid-template-columns: 1fr;
      }
    }

    
    /* ── PRECIOS Y TARIFAS MINIMALISTAS (RECOMENDACIÓN DE DISEÑO) ── */
    .ed-price-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 8px;
      padding: 5px 12px;
      background: rgba(217, 107, 39, 0.08);
      border: 1px solid rgba(217, 107, 39, 0.28);
      border-radius: 8px;
      font-size: 13px;
      color: var(--ink);
    }
    .ed-price-val {
      font-size: 15px;
      font-weight: 800;
      color: var(--or);
      letter-spacing: -.01em;
    }
    .ed-price-desc {
      font-size: 12px;
      color: var(--mut);
      font-weight: 500;
    }

    .tarifas-card {
      background: #FFFFFF;
      border: 1.5px solid var(--ln);
      border-radius: 20px;
      padding: 30px;
      margin-bottom: 48px;
      box-shadow: 0 4px 20px -2px rgba(24, 37, 31, .06);
    }
    .tarifas-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 14px;
      border-bottom: 1.5px solid var(--ln);
      padding-bottom: 16px;
    }
    .tarifas-badge {
      font-size: 12px;
      font-weight: 600;
      color: var(--g);
      background: var(--sand-light);
      padding: 6px 12px;
      border-radius: 20px;
      border: 1px solid var(--ln);
    }
    .tarifas-table-wrap {
      overflow-x: auto;
      border-radius: 14px;
      border: 1px solid var(--ln);
    }
    .tarifas-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 12.5px;
    }
    .tarifas-table th {
      background: var(--g);
      color: #FFFFFF;
      padding: 13px 15px;
      font-weight: 700;
      font-size: 12px;
      letter-spacing: .02em;
    }
    .tarifas-table td {
      padding: 12px 15px;
      border-bottom: 1px solid #EAE6DD;
      color: var(--ink);
      line-height: 1.4;
    }
    .tarifas-table tr:nth-child(even) td {
      background: #FAF8F4;
    }
    .tarifas-table tr:hover td {
      background: #F4EFE6;
    }
    .tarifas-price {
      font-size: 14.5px;
      font-weight: 800;
      color: var(--or);
      white-space: nowrap;
    }
    .tarifas-num {
      font-family: 'Fraunces', serif;
      font-weight: 800;
      color: var(--or);
      font-size: 15px;
    }
    .tarifas-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 12px;
      background: #25D366;
      color: #FFFFFF;
      border-radius: 8px;
      font-size: 11.5px;
      font-weight: 700;
      text-decoration: none;
      transition: opacity .2s ease;
    }
    .tarifas-link:hover {
      opacity: .9;
    }

    /* Unificar texto y citas a un solo color relajante */
    .ed-quote {
      color: var(--ink) !important;
      border-left: 3px solid var(--or);
      font-style: italic;
    }
    .ed-story {
      color: var(--ink) !important;
      font-size: 14px;
      line-height: 1.6;
    }

    /* ── IMPRESIÓN Y PDF EDITORIAL A4 (17 PÁGINAS EXACTAS, 0 BLANCOS, ENCUADRE DE REVISTA) ── */
    @media print {
      @page {
        size: A4 portrait;
        margin: 10mm 12mm;
      }

      *, *:before, *:after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        box-sizing: border-box !important;
      }

      /* Revelar todo el contenido inmediatamente */
      .reveal, .reveal.active, [class*="reveal"] {
        opacity: 1 !important;
        transform: none !important;
        visibility: visible !important;
        transition: none !important;
      }

      /* Ocultar elementos web no imprimibles */
      nav, .nav-actions, .btn, .btn-pdf-sub, .ed-social-bar, .ed-cta-box, .fl-showcase, .map-toggle-wrap, iframe, .editor-index, .idx {
        display: none !important;
      }

      /* REGLA DE ORO ANTI-CORTES: Ninguna tarjeta puede dividirse entre páginas */
      .rc, .fc, .gf-item, .fact, .pc, .st div, .ed-toc-item, .tarifas-card, .qr-card, .ed-photo-frame, .ed-col-story, .ed-spread {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        -webkit-column-break-inside: avoid !important;
      }

      html, body {
        background: #FFFFFF !important;
        color: #18251F !important;
        font-size: 8.8pt !important;
        line-height: 1.34 !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
      }

      .w {
        max-width: 100% !important;
        width: 100% !important;
        padding: 0 2mm !important;
        margin: 0 auto !important;
      }

      /* PÁGINA 1: PORTADA EDITORIAL */
      .hero {
        min-height: 260mm !important;
        height: 260mm !important;
        max-height: 260mm !important;
        padding: 30mm 15mm 20mm !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
        align-items: center !important;
        text-align: center !important;
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        background: #0F3D2A !important;
        color: #FFFFFF !important;
        box-sizing: border-box !important;
      }
      .hero:before { display: none !important; }
      .hero * { color: #FFFFFF !important; }
      .hero h1 { font-size: 34pt !important; line-height: 1.1 !important; margin-bottom: 12pt !important; }
      .hero p { font-size: 12pt !important; line-height: 1.35 !important; max-width: 82% !important; margin: 0 auto 16pt !important; }
      .hero-badges { gap: 8pt !important; }
      .hero-badges .badge { border: 1px solid rgba(255,255,255,0.5) !important; font-size: 8.5pt !important; padding: 3pt 8pt !important; }

      /* PÁGINA 2: EL PROYECTO / MANIFIESTO */
      #proyecto {
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 12mm 0 6mm !important;
        height: 260mm !important;
        max-height: 260mm !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
      }
      #proyecto h2 { font-size: 24pt !important; margin-bottom: 8pt !important; }
      #proyecto p.lead { font-size: 11pt !important; line-height: 1.35 !important; margin-bottom: 10pt !important; }
      .grid-4 {
        display: grid !important;
        grid-template-columns: repeat(4, 1fr) !important;
        gap: 8pt !important;
        margin: 14pt 0 !important;
      }
      .card {
        padding: 10pt !important;
        border: 1px solid #D6D0C2 !important;
        border-radius: 8pt !important;
        background: #FFFFFF !important;
        box-shadow: none !important;
      }
      .card h3 { font-size: 11pt !important; margin-bottom: 4pt !important; }
      .card p { font-size: 8pt !important; line-height: 1.3 !important; }

      /* PÁGINA 3: EL DESTINO (TERRITORIO) */
      #destino {
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 12mm 0 6mm !important;
        height: 260mm !important;
        max-height: 260mm !important;
        background: #FAFAF7 !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
      }
      #destino h2 { font-size: 24pt !important; margin-bottom: 8pt !important; }
      #destino p.lead { font-size: 10.5pt !important; line-height: 1.35 !important; margin-bottom: 10pt !important; }
      .facts {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 8pt !important;
        margin-top: 10pt !important;
      }
      .fact {
        padding: 9pt 11pt !important;
        border: 1px solid #D6D0C2 !important;
        border-radius: 8pt !important;
        background: #FFFFFF !important;
        box-shadow: none !important;
      }
      .fact h3 { font-size: 11pt !important; margin-bottom: 3pt !important; }
      .fact p { font-size: 8pt !important; line-height: 1.3 !important; }

      /* PÁGINA 4: LOS 4 PILARES */
      #pilares {
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 12mm 0 6mm !important;
        height: 260mm !important;
        max-height: 260mm !important;
        box-sizing: border-box !important;
        overflow: hidden !important;
      }
      #pilares h2 { font-size: 24pt !important; margin-bottom: 8pt !important; }
      #pilares p.lead { font-size: 11pt !important; line-height: 1.35 !important; margin-bottom: 12pt !important; }
      .pilares {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 10pt !important;
        margin-top: 10pt !important;
      }
      .pc {
        padding: 10pt 12pt !important;
        border: 1px solid #D6D0C2 !important;
        border-radius: 8pt !important;
        background: #FFFFFF !important;
        box-shadow: none !important;
      }
      .pc h3 { font-size: 12pt !important; margin: 4pt 0 !important; }
      .pc p { font-size: 8pt !important; line-height: 1.3 !important; }

      /* PÁGINA 5: ÍNDICE DE LOS 10 CONVENIOS */
      #convenios {
        page-break-after: auto !important;
        break-after: auto !important;
        padding: 10mm 0 0 !important;
        background: #FAFAF7 !important;
      }
      #convenios h2 { font-size: 22pt !important; margin-bottom: 6pt !important; }
      #convenios p.lead { font-size: 10pt !important; margin-bottom: 10pt !important; }
      #convenios .ed-toc-container {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 7pt 12pt !important;
        margin-top: 10pt !important;
        margin-bottom: 0 !important;
        page-break-after: always !important;
        break-after: page !important;
      }
      #convenios .ed-toc-item {
        padding: 7pt 10pt !important;
        min-height: 40pt !important;
        border: 1.5px solid #C5A059 !important;
        box-shadow: none !important;
        border-radius: 9pt !important;
        background: #FFFFFF !important;
        gap: 8pt !important;
      }
      #convenios .ed-toc-logo {
        width: 28pt !important;
        height: 28pt !important;
      }
      #convenios .ed-toc-num {
        font-size: 14pt !important;
      }
      #convenios .ed-toc-name {
        font-size: 9.5pt !important;
        line-height: 1.2 !important;
      }
      #convenios .ed-toc-cat {
        font-size: 7.5pt !important;
        line-height: 1.2 !important;
      }

      /* PÁGINAS 6 A 15: CADA CRÓNICA EN EXACTAMENTE 1 PÁGINA (0 CORTES, 0 MOTAS) */
      .ed-spread {
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        height: 260mm !important;
        max-height: 260mm !important;
        min-height: 260mm !important;
        padding: 2mm 0 !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
        background: #FFFFFF !important;
        border-top: none !important;
        overflow: hidden !important;
      }
      .ed-spread:nth-of-type(even) {
        background: #FAFAF7 !important;
      }

      .ed-grid-a, .ed-grid-b, .ed-grid-c, .ed-grid-d, .ed-grid-e {
        display: grid !important;
        grid-template-columns: 1.05fr 0.95fr !important;
        gap: 14pt !important;
        align-items: stretch !important;
        height: 100% !important;
      }

      .ed-col-photo, .ed-col-photo-dual, .ed-col-photo-vertical, .ed-col-photo-science {
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
        height: 100% !important;
        order: 1 !important;
        gap: 8pt !important;
      }

      .ed-photo-frame {
        position: relative !important;
        border-radius: 10pt !important;
        overflow: hidden !important;
        border: 1px solid #C5A059 !important;
        box-shadow: none !important;
      }
      .ed-photo-frame img.ed-img-cover {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        display: block !important;
      }
      .ed-photo-tag {
        font-size: 7pt !important;
        padding: 2.5pt 7pt !important;
        bottom: 6pt !important;
        left: 6pt !important;
      }

      .ed-col-photo-dual .main-frame {
        height: 245pt !important;
        margin-bottom: 0 !important;
      }
      .ed-col-photo-dual .sub-frame {
        height: 155pt !important;
        margin-bottom: 0 !important;
      }
      .ed-col-photo-vertical .vertical-frame {
        height: 410pt !important;
      }

      .ed-col-story {
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
        height: 100% !important;
        order: 2 !important;
        padding: 2pt 0 !important;
      }

      .ed-header {
        margin-bottom: 4pt !important;
      }
      .ed-folio {
        margin-bottom: 2pt !important;
      }
      .ed-num {
        font-size: 20pt !important;
      }
      .ed-tag {
        font-size: 7.2pt !important;
        letter-spacing: 1.5px !important;
      }
      .ed-brand-row {
        gap: 10pt !important;
      }
      .ed-logo-circle {
        width: 48pt !important;
        height: 48pt !important;
        padding: 3pt !important;
        border: 2px solid #C5A059 !important;
        background: #FFFFFF !important;
      }
      .ed-brand-row .eb {
        font-size: 7pt !important;
        padding: 1.5pt 6pt !important;
        margin-bottom: 2pt !important;
      }
      .ed-name {
        font-size: 16pt !important;
        margin: 0 !important;
      }
      .ed-price-pill { display: none !important; }

      .ed-headline {
        font-size: 12.5pt !important;
        line-height: 1.2 !important;
        margin: 0 0 3pt 0 !important;
      }
      .ed-quote {
        font-size: 7.8pt !important;
        line-height: 1.25 !important;
        border-left: 2px solid #C5A059 !important;
        padding-left: 6pt !important;
        margin: 0 0 4pt 0 !important;
        font-style: italic !important;
      }
      .ed-story {
        font-size: 7.4pt !important;
        line-height: 1.25 !important;
        margin-bottom: 4pt !important;
      }

      .ed-field-notes {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 4.5pt !important;
        margin-bottom: 3pt !important;
      }
      .ed-fn-item {
        padding: 3.5pt 6pt !important;
        border: 1px solid #D6D0C2 !important;
        border-radius: 6pt !important;
        background: #FFFFFF !important;
      }
      .ed-fn-label {
        font-size: 6.2pt !important;
        text-transform: uppercase !important;
        letter-spacing: 0.8px !important;
      }
      .ed-fn-val {
        font-size: 7.2pt !important;
        line-height: 1.2 !important;
      }

      .ed-tip-box {
        padding: 3.5pt 7pt !important;
        font-size: 6.8pt !important;
        line-height: 1.2 !important;
        border-radius: 6pt !important;
        margin-bottom: 2pt !important;
        border: 1px solid rgba(197, 160, 89, 0.4) !important;
        background: #FFFDF8 !important;
      }

      .ed-chips-box {
        margin-top: 2pt !important;
      }
      .ed-chips-title {
        font-size: 6.8pt !important;
        margin-bottom: 2pt !important;
      }
      .ed-chips-list .chip {
        font-size: 6.5pt !important;
        padding: 1.5pt 5pt !important;
      }

      .ed-social-bar {
        display: flex !important;
        gap: 8pt !important;
        margin-top: 3pt !important;
      }
      .ed-soc-link {
        font-size: 7pt !important;
        gap: 3pt !important;
      }

      .ed-cta-box { display: none !important; }

      /* PÁGINA 16: RUTAS SUGERIDAS (PÁGINA COMPLETA EXCLUSIVA, 0 CORTES) */
      #rutas {
        page-break-before: always !important;
        break-before: page !important;
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 14mm 0 8mm !important;
        min-height: 275mm !important;
        box-sizing: border-box !important;
        background: #FFFFFF !important;
      }
      #rutas h2 { font-size: 22pt !important; margin-bottom: 6pt !important; }
      #rutas p.lead { font-size: 10pt !important; margin-bottom: 12pt !important; }
      .rt-container {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 12pt !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .rc {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 12pt 10pt !important;
        border: 1px solid #D6D0C2 !important;
        box-shadow: none !important;
        border-radius: 12pt !important;
        background: #FAF8F4 !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
      }
      .rc h3 { font-size: 11pt !important; margin: 3pt 0 6pt !important; color: #0F3D2A !important; }
      .rc ol li { font-size: 7.2pt !important; margin-bottom: 3pt !important; line-height: 1.3 !important; }
      .rc ol li b { font-size: 7.6pt !important; color: #D96B27 !important; }

      /* PÁGINA 18: GUÍA DEL VIAJERO Y CÓDIGO QR (PÁGINA COMPLETA EXCLUSIVA, 0 CORTES) */
      #guia {
        page-break-before: always !important;
        break-before: page !important;
        page-break-after: always !important;
        break-after: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 14mm 0 !important;
        min-height: 270mm !important;
        background: #FAFAF7 !important;
        box-sizing: border-box !important;
      }
      .guia-grid {
        display: grid !important;
        grid-template-columns: 1.15fr 0.85fr !important;
        gap: 14pt !important;
        align-items: start !important;
      }
      .guia-facts {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 8pt !important;
      }
      .fc {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 8pt 10pt !important;
        border: 1px solid #D6D0C2 !important;
        border-radius: 8px !important;
        background: #FFFFFF !important;
        font-size: 7.5pt !important;
        line-height: 1.35 !important;
        box-shadow: none !important;
      }
      .fc h3 {
        font-size: 9pt !important;
        margin-bottom: 4pt !important;
        color: #0F3D2A !important;
      }
      .qr-card {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        padding: 12pt 10pt !important;
        border: 1.5px solid #C5A059 !important;
        box-shadow: none !important;
        text-align: center !important;
        background: #FFFFFF !important;
      }
      .qr-box {
        width: 90pt !important;
        height: 90pt !important;
        margin: 6pt auto !important;
      }
      .qr-img {
        width: 100% !important;
        height: 100% !important;
      }

      /* PÁGINA 19: CONTRAPORTADA Y CRÉDITOS */
      footer {
        page-break-before: always !important;
        break-before: page !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        min-height: 270mm !important;
        padding: 40mm 15mm !important;
        background: #0F3D2A !important;
        color: #FFFFFF !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
        align-items: center !important;
        text-align: center !important;
        box-sizing: border-box !important;
      }
      footer * { color: #FFFFFF !important; }
      .fl-title { font-size: 20pt !important; margin-bottom: 12pt !important; }
      .fl-desc { font-size: 10pt !important; max-width: 80% !important; line-height: 1.5 !important; margin-bottom: 16pt !important; }
      .fl-credits { border-top: 1px solid rgba(255,255,255,0.2) !important; padding-top: 12pt !important; width: 100% !important; }
    }
  </style>
</head>
<body>

